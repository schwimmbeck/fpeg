// JSON with comments and trailing commas, as an extension of the JSON grammar: the comments of
// C and C++ are skipped, and an object or array may end with a comma.

%extends "json"

object: "{" ((member ++ ",") ","?)? "}" => dict
array: "[" ((value ++ ",") ","?)? "]" => list

%ignore "//" [^\r\n]* | "/*" (!"*/" .)* "*/"
