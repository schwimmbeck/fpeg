// Comma-separated values: records of fields, quoted fields may hold commas, quotes written
// twice and line breaks. An empty line is a record without fields.

start: (line _EOL)* record?
?line: record | () -> record => list
record: &[^\r\n] fields=(field ++ ",") => list
field: value=(QUOTED | BARE)?

QUOTED: "\"" ([^"] | "\"\"")* "\""
BARE: [^,"\r\n]+
_EOL: "\r\n" | "\n" | "\r"
