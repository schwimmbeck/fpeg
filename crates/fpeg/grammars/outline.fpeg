// An indentation-based outline: entries are keys with an optional value, and an entry's
// children are the entries indented under it. A block ends where a line returns to an outer
// column, and a line at a column that no open block uses is an error. Blank and comment lines
// do not count.

%ignore " "+ | COMMENT

start: _NL? entries=(%same entry)*
entry: key=KEY ":" value=VALUE? (_NL | !.) children=children?
children: %indent(entries=(%same entry)+)

KEY "key": [A-Za-z_] [A-Za-z0-9_\-]*
VALUE "value": [^ \r\n#] [^\r\n#]*
COMMENT: "#" [^\r\n]*
_NL "line break": (("\r\n" | "\n") " "* COMMENT?)+
