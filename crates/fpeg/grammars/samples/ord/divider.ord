from ordec.core import *
from ordec.lib import Res


cell Divider:
    """A voltage divider of two resistors."""

    viewgen symbol(self) -> Symbol:
        input vin
        output vout
        inout gnd

    viewgen schematic(self) -> Schematic:
        port vin: .pos=(0, 6)
        port vout: .pos=(8, 3)
        port gnd: .orient=East; .pos=(0, 0)
        net mid

        Res r1: .$r=10k; .pos=(4, 4); .p -- vin; .m -- vout
        Res r2: .$r=4.7k; .pos=(4, 1); .p -- vout; .m -- gnd
        ! .vout.pos.y < .vin.pos.y
