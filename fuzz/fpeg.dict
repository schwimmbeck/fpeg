# The words of the grammar language, for libFuzzer's -dict option.
"start: "
"\x0a"
"\x00"
"%ignore "
"%word "
"%flag "
"%tabs "
"%keywords soft "
"%precedence {"
"%on("
"%off("
"%if("
"%if(!"
"%indent("
"%same"
"%def("
"%ref("
"%error("
"@lexical\x0a"
"@reserved\x0a"
"->"
"=>"
"**"
"++"
"~"
"^"
"?"
"[a-z]"
"[^\"]"
"\\p{XID_Start}"
"\"i"
"<p>"
"_"
